.game-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 20rpx 20rpx 0;
  box-sizing: border-box;
  background: #FBF4E6;
}

.hud {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 4rpx 10rpx 0;
}
.hud-left {
  display: flex;
  flex-direction: column;
}
.hud-label {
  font-size: 22rpx;
  color: var(--muted);
  letter-spacing: 3rpx;
}
.hud-clock {
  font-family: "KaiTi", "STKaiti", serif;
  font-size: 50rpx;
  line-height: 1.2;
  color: var(--deep);
}
.hud-right {
  text-align: right;
}
.hud-score {
  font-size: 66rpx;
  line-height: 1.1;
  font-weight: 700;
  color: var(--cinnabar);
}
.hud-best {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

.timebar {
  height: 4rpx;
  margin: 12rpx 10rpx 0;
  background: rgba(107, 25, 23, 0.12);
  border-radius: 2rpx;
  overflow: hidden;
}
.timebar-fill {
  height: 100%;
  background: var(--cinnabar);
  transition: width 0.35s linear;
}

.stage-wrap {
  flex: 1;
  min-height: 0;
  position: relative;
  margin-top: 14rpx;
  border: 1px solid rgba(107, 25, 23, 0.12);
  border-radius: 16rpx;
  overflow: hidden;
  background: #F3E7D0;
}
.stage {
  width: 100%;
  height: 100%;
  display: block;
}
.hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: rgba(74, 50, 40, 0.5);
  letter-spacing: 2rpx;
  pointer-events: none;
}

.over-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(40, 15, 14, 0.72);
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}
.over-card {
  width: 100%;
  background: var(--paper);
  border-radius: 20rpx;
  padding: 44rpx 36rpx 36rpx;
  box-sizing: border-box;
  text-align: center;
}
.over-label {
  font-family: "KaiTi", "STKaiti", serif;
  font-size: 26rpx;
  color: var(--muted);
  letter-spacing: 6rpx;
}
.over-score {
  font-size: 108rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--deep);
  margin-top: 10rpx;
}
.over-unit {
  font-size: 26rpx;
  font-weight: 400;
  color: var(--muted);
  margin-left: 8rpx;
}
.over-gain {
  font-size: 24rpx;
  color: var(--jade);
  margin: 10rpx 0 30rpx;
}
.over-card .btn-main {
  margin-bottom: 16rpx;
}
.over-back {
  font-size: 24rpx;
  color: var(--muted);
  padding: 16rpx 0 4rpx;
}

/* 金羊出圈：羊圈棋盘 + 五关串联 + 省圈场景 */
.game-page {
  min-height: 100vh;
  padding: 16rpx 30rpx 40rpx;
  box-sizing: border-box;
  background: #FBF4E6;
  background-image: repeating-linear-gradient(93deg, rgba(107, 25, 23, 0.022) 0, rgba(107, 25, 23, 0.022) 1px, transparent 1px, transparent 6px);
}

/* ===== 顶部 ===== */
.hud {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 6rpx 2rpx 0;
}
.hud-k {
  font-family: "KaiTi", "STKaiti", serif;
  font-size: 34rpx;
  color: #6B1917;
  letter-spacing: 2rpx;
}
.hud-n {
  font-size: 22rpx;
  color: #8B7965;
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}
.hud-r {
  text-align: right;
}
.dots {
  display: flex;
  justify-content: flex-end;
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  border: 2rpx solid #241A16;
  margin-left: 10rpx;
  box-sizing: border-box;
}
.dot.on {
  background: #C0372E;
  border-color: #C0372E;
}
.dot.now {
  border-color: #C0372E;
  background: #FFFBF2;
}
.steps {
  font-size: 24rpx;
  color: #8B7965;
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}
.steps .b {
  font-family: "KaiTi", "STKaiti", serif;
  font-size: 40rpx;
  color: #6B1917;
  margin: 0 2rpx;
}
.steps.low .b {
  color: #C99A3D;
}

/* ===== 棋盘 ===== */
.board-wrap {
  margin-top: 14rpx;
  display: flex;
  justify-content: center;
}
.board {
  position: relative;
  border: 2rpx solid #241A16;
  border-radius: 8rpx;
  background: #F3E7D0;
  background-image:
    repeating-linear-gradient(90deg, rgba(139, 106, 71, 0.14) 0, rgba(139, 106, 71, 0.14) 1px, transparent 1px, transparent 24rpx),
    repeating-linear-gradient(0deg, rgba(139, 106, 71, 0.14) 0, rgba(139, 106, 71, 0.14) 1px, transparent 1px, transparent 24rpx);
  overflow: hidden;
}
.gate {
  position: absolute;
  border: 3rpx dashed rgba(192, 55, 46, 0.55);
  border-radius: 6rpx;
  box-sizing: border-box;
}
.gate::after {
  content: "门";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: "KaiTi", "STKaiti", serif;
  font-size: 22rpx;
  color: rgba(107, 25, 23, 0.62);
}
.rock {
  position: absolute;
  border-radius: 8rpx;
  background: #7E7466;
  box-shadow: inset -3rpx -4rpx 0 rgba(0, 0, 0, 0.2), inset 3rpx 3rpx 0 rgba(255, 255, 255, 0.22);
  transform: scale(0.92);
}

/* ===== 羊 ===== */
.tok {
  position: absolute;
  transition: left 0.18s cubic-bezier(0.34, 0.9, 0.3, 1), top 0.18s cubic-bezier(0.34, 0.9, 0.3, 1), opacity 0.4s;
}
.tok.sheep {
  z-index: 5;
}
.s-body {
  position: absolute;
  left: 3%;
  top: 28%;
  width: 82%;
  height: 50%;
  border-radius: 50%;
  background: #FFFDF6;
  border: 2rpx solid #26221C;
  box-sizing: border-box;
}
.s-head {
  position: absolute;
  left: 58%;
  top: 6%;
  width: 34%;
  height: 34%;
  border-radius: 50%;
  background: #FFFDF6;
  border: 2rpx solid #26221C;
  box-sizing: border-box;
}
.s-ear {
  position: absolute;
  width: 12%;
  height: 17%;
  border-radius: 50%;
  background: #FFFDF6;
  border: 2rpx solid #26221C;
  box-sizing: border-box;
}
.s-ear.e1 {
  left: 56%;
  top: 1%;
  transform: rotate(-22deg);
}
.s-ear.e2 {
  left: 84%;
  top: 1%;
  transform: rotate(22deg);
}
.s-eye {
  position: absolute;
  width: 6%;
  height: 6%;
  border-radius: 50%;
  background: #26221C;
}
.s-eye.e3 {
  left: 67%;
  top: 20%;
}
.s-eye.e4 {
  left: 80%;
  top: 20%;
}
.s-leg {
  position: absolute;
  width: 6%;
  height: 16%;
  background: #26221C;
  border-radius: 2rpx;
  bottom: 4%;
}
.s-leg.l1 {
  left: 26%;
}
.s-leg.l2 {
  left: 60%;
}

/* 箭头：小折角，靠旋转指方向 */
.arw {
  position: absolute;
  width: 15rpx;
  height: 15rpx;
  border-top: 3rpx solid #C0372E;
  border-right: 3rpx solid #C0372E;
  border-top-right-radius: 2rpx;
}
.arw.R {
  right: -4rpx;
  top: 42%;
  transform: rotate(45deg);
}
.arw.L {
  left: -4rpx;
  top: 42%;
  transform: rotate(-135deg);
}
.arw.U {
  top: -4rpx;
  left: 42%;
  transform: rotate(-45deg);
}
.arw.D {
  bottom: -4rpx;
  left: 42%;
  transform: rotate(135deg);
}

/* 金羊 */
.tok.gold {
  z-index: 6;
  pointer-events: none;
}
.tok.gold .s-body,
.tok.gold .s-head {
  background: #E6C15C;
  border-color: #8A5C1B;
}
.halo {
  position: absolute;
  left: -8rpx;
  top: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border: 1rpx dashed rgba(201, 154, 61, 0.9);
  border-radius: 50%;
}
.crown {
  position: absolute;
  left: 60%;
  top: -4%;
  width: 0;
  height: 0;
  border-left: 7rpx solid transparent;
  border-right: 7rpx solid transparent;
  border-bottom: 14rpx solid #F2D08A;
  transform: rotate(-8deg);
}
.bell {
  position: absolute;
  left: 74%;
  top: 30%;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #B23A2E;
}

/* 狼 */
.tok.wolf {
  z-index: 8;
  pointer-events: none;
  transition: left 0.6s cubic-bezier(0.3, 0.85, 0.3, 1), top 0.6s cubic-bezier(0.3, 0.85, 0.3, 1);
}
.w-body {
  position: absolute;
  left: 2%;
  top: 40%;
  width: 68%;
  height: 46%;
  border-radius: 50%;
  background: #57503F;
  border: 2rpx solid #1E1B16;
  box-sizing: border-box;
}
.w-head {
  position: absolute;
  left: 54%;
  top: 22%;
  width: 40%;
  height: 40%;
  border-radius: 50%;
  background: #57503F;
  border: 2rpx solid #1E1B16;
  box-sizing: border-box;
}
.w-ear {
  position: absolute;
  width: 0;
  height: 0;
  border-left: 9rpx solid transparent;
  border-right: 9rpx solid transparent;
  border-bottom: 22rpx solid #4A4437;
}
.w-ear.a {
  left: 55%;
  top: 6%;
  transform: rotate(-14deg);
}
.w-ear.b {
  left: 77%;
  top: 5%;
  transform: rotate(14deg);
}
.w-eye {
  position: absolute;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #D9A227;
}
.w-eye.x {
  left: 64%;
  top: 34%;
}
.w-eye.y {
  left: 80%;
  top: 33%;
}

/* 抖一下 / 撞墙 */
.bump {
  animation: bump 0.26s ease-in-out;
}
@keyframes bump {
  0%, 100% { margin-left: 0; }
  25% { margin-left: -6rpx; }
  75% { margin-left: 6rpx; }
}

.min-note {
  text-align: center;
  font-size: 22rpx;
  color: #8B7965;
  margin-top: 12rpx;
  letter-spacing: 1rpx;
}

/* ===== 方向键 ===== */
.pad {
  width: 580rpx;
  margin: 14rpx auto 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 96rpx);
  gap: 10rpx;
}
.pad-btn {
  border: 1rpx solid rgba(107, 25, 23, 0.28);
  background: #FFFBF2;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pad-btn:active {
  background: #F0E3CC;
}
.pad-btn.up { grid-area: 1 / 2; }
.pad-btn.left { grid-area: 2 / 1; }
.pad-btn.right { grid-area: 2 / 3; }
.pad-btn.down { grid-area: 3 / 2; }
.pad-mid {
  grid-area: 2 / 2;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pad-mid-t {
  font-family: "KaiTi", "STKaiti", serif;
  font-size: 20rpx;
  color: #8B7965;
  line-height: 1.3;
  text-align: center;
}
.tri {
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 22rpx solid #241A16;
}
.tri.left { transform: rotate(-90deg); }
.tri.right { transform: rotate(90deg); }
.tri.down { transform: rotate(180deg); }

.foot {
  display: flex;
  margin-top: 18rpx;
}
.foot-btn {
  flex: 1;
  margin: 0 6rpx;
  font-size: 24rpx;
  color: #6B1917;
  background: transparent;
  border: 1rpx solid rgba(107, 25, 23, 0.28);
  border-radius: 10rpx;
  padding: 14rpx 0;
  line-height: 1.4;
}
.foot-btn::after {
  border: 0;
}

/* ===== 省圈场景 ===== */
.scene {
  padding: 20rpx 6rpx 0;
  text-align: center;
}
.scene-k {
  font-size: 22rpx;
  color: #8B7965;
  letter-spacing: 4rpx;
}
.scene-t {
  font-family: "KaiTi", "STKaiti", serif;
  font-size: 46rpx;
  color: #6B1917;
  margin-top: 14rpx;
  line-height: 1.35;
}
.pen {
  position: relative;
  height: 380rpx;
  margin-top: 24rpx;
  border: 2rpx solid #241A16;
  border-radius: 8rpx;
  background: #F3E7D0;
  background-image: repeating-linear-gradient(90deg, rgba(139, 106, 71, 0.16) 0, rgba(139, 106, 71, 0.16) 1px, transparent 1px, transparent 16rpx);
  overflow: hidden;
}
.flock {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
  flex-wrap: wrap;
}
.mini {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  margin-right: 8rpx;
  opacity: 0.9;
}
.mini .s-body {
  left: 0;
  top: 26%;
  width: 84%;
  height: 50%;
}
.mini .s-head {
  left: 58%;
  top: 4%;
  width: 36%;
  height: 36%;
}
.gold-body {
  background: #E6C15C !important;
  border-color: #8A5C1B !important;
}
.gold-in {
  position: absolute;
  right: -100rpx;
  bottom: 26rpx;
  width: 84rpx;
  height: 84rpx;
  transition: right 0.8s cubic-bezier(0.3, 0.85, 0.3, 1);
}
.gold-in.go {
  right: 30rpx;
}
.gold-in .s-body {
  left: 2%;
  top: 30%;
  width: 80%;
  height: 48%;
  background: #E6C15C;
  border-color: #8A5C1B;
}
.gold-in .s-head {
  left: 56%;
  top: 6%;
  width: 32%;
  height: 32%;
  background: #E6C15C;
  border-color: #8A5C1B;
}
.gold-in .crown {
  left: 62%;
  top: -2%;
}
.spark {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  transition: transform 0.85s ease-out, opacity 0.85s ease-out;
}
.fw {
  font-family: "KaiTi", "STKaiti", serif;
  font-size: 30rpx;
  color: #241A16;
  margin-top: 26rpx;
  letter-spacing: 1rpx;
}
.fw-n {
  color: #C0372E;
  font-size: 44rpx;
  margin: 0 4rpx;
}
.fw-s {
  font-size: 22rpx;
  color: #8B7965;
  margin-top: 8rpx;
}
.scene-btn {
  margin-top: 30rpx;
}
.back {
  font-size: 24rpx;
  color: #8B7965;
  padding: 20rpx 0 10rpx;
}

/* ===== 失败卡 ===== */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(40, 15, 14, 0.72);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: #FBF4E6;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  text-align: center;
}
.sheet-t {
  font-family: "KaiTi", "STKaiti", serif;
  font-size: 42rpx;
  color: #6B1917;
  letter-spacing: 3rpx;
}
.sheet-b {
  font-size: 26rpx;
  color: #8B7965;
  line-height: 1.8;
  margin: 14rpx 0 8rpx;
}
.sheet-s {
  font-size: 22rpx;
  color: #8B7965;
  letter-spacing: 1rpx;
  margin-bottom: 24rpx;
}
.ad-off {
  font-size: 22rpx;
  color: #8B7965;
  padding: 20rpx 0;
}
.sheet .btn-line {
  margin-top: 14rpx;
}

/* ===== 过关卡 ===== */
.pass {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(251, 244, 230, 0.94);
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pass-card {
  text-align: center;
  padding: 0 60rpx;
}
.pass-t {
  font-family: "KaiTi", "STKaiti", serif;
  font-size: 48rpx;
  color: #C0372E;
  letter-spacing: 3rpx;
}
.pass-b {
  font-size: 26rpx;
  color: #241A16;
  line-height: 1.8;
  margin-top: 16rpx;
}
.pass-s {
  font-size: 22rpx;
  color: #8B7965;
  margin-top: 10rpx;
}
.pass-n {
  font-size: 24rpx;
  color: #8B7965;
  margin-top: 34rpx;
  letter-spacing: 2rpx;
}
